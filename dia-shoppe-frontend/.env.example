# Copy to .env for local dev, and add these same keys in your host's
# "Environment variables" settings for production. Never commit the real .env
# (it's gitignored). The Supabase anon key is safe to expose — RLS protects data.

# ── Required ──
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# ── Analytics (recommended) ──
VITE_POSTHOG_KEY=phc_xxxxxxxx
VITE_POSTHOG_HOST=https://us.i.posthog.com

# ── Error monitoring (optional — leave blank to disable Sentry) ──
VITE_SENTRY_DSN=

# ── Instagram/Facebook connect buttons (optional, once Meta app exists) ──
VITE_META_APP_ID=
